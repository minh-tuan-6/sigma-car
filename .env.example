# ===================================================================
# SIGMACAR Platform Environment Configuration
# Copy this file to .env and configure for your local/production environment
# ===================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
# Generate a secure 32+ character string in production
JWT_SECRET=sigmacar_super_secret_jwt_key_production_ready_2026_change_me
SESSION_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=100

# Future Database Connection
# When the real database is provided, set the connection string below:
# Supported dialects: postgresql, mysql, mongodb, sqlite
DATABASE_URL=sqlite://./data/sigmacar_production.db
DATABASE_DIALECT=sqlite
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# AI Provider Configuration (Primary: Google Gemini 2.5 Flash)
# Options: gemini | local-automotive | groq | openai | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ALLOW_LOCAL_FALLBACK=true

# Alternative AI Providers (Optional)
GROQ_API_KEY=your_optional_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_optional_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Payment & Notification Gateways (Sandboxed)
PAYMENT_GATEWAY_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=whsec_sigmacar_sandbox_key
NOTIFICATION_EMAIL_SENDER=noreply@sigmacar.vn

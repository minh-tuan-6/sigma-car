# ===================================================================
# SIGMACAR Platform Environment Configuration
# Copy this file to .env and configure for your local/production environment
# ===================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
# Generate a secure 32+ character string in production
JWT_SECRET=sigmacar_super_secret_jwt_key_production_ready_2026_change_me
SESSION_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=100

# Persistent JSON store location (mount a volume here in production; default: ./data/sigmacar_store.json)
# SIGMACAR_DATA_FILE=/data/sigmacar_store.json

# Reverse proxy (Cloudflare Pages Function → this backend). See docs/CLOUDFLARE_DEPLOYMENT.md
# TRUST_PROXY=true                      # rate-limit by forwarded client IP instead of the proxy IP
# PROXY_SHARED_SECRET=                  # >= 32 chars; must equal SIGMA_PROXY_SHARED_SECRET on Pages; rejects direct calls
# CORS_ALLOWED_ORIGINS=                 # only needed if the browser calls this API cross-origin (not needed with the proxy)

# AR Quick Look: public HTTPS base for pre-built USDZ files larger than the Cloudflare Pages 25 MiB file limit
# (e.g. an R2 bucket: node scripts/upload_usdz.js --bucket <name> --execute). Set it on the backend AND as a
# Pages build variable. Unset → those colours are converted on the iPhone/iPad instead.
# SIGMACAR_USDZ_PUBLIC_BASE_URL=https://usdz.example.com

# Future Database Connection
# When the real database is provided, set the connection string below:
# Supported dialects: postgresql, mysql, mongodb, sqlite
DATABASE_URL=sqlite://./data/sigmacar_production.db
DATABASE_DIALECT=sqlite
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# AI Provider Configuration (Primary: Google Gemini 2.5 Flash)
# Options: gemini | local-automotive | groq | openai | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ALLOW_LOCAL_FALLBACK=true

# Alternative AI Providers (Optional)
GROQ_API_KEY=your_optional_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_optional_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Payment & Notification Gateways (Sandboxed)
PAYMENT_GATEWAY_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=whsec_sigmacar_sandbox_key
NOTIFICATION_EMAIL_SENDER=noreply@sigmacar.vn

{
  "name": "sigmacar-platform",
  "version": "1.0.0",
  "description": "Production-ready full-stack electric vehicle commerce platform for SIGMACAR",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build_dist.js",
    "start": "node server.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/**/*.test.js",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.js",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/integration/*.test.js",
    "test:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/security/*.test.js",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:3000 --protocol http2",
    "test:e2e": "node tests/e2e/ar-flow.e2e.js",
    "vendor:ar": "node scripts/vendor_ar_libs.js",
    "usdz:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build_usdz.js",
    "usdz:upload": "node scripts/upload_usdz.js"
  },
  "keywords": [
    "sigmacar",
    "electric-vehicles",
    "ecommerce",
    "ai-advisor",
    "node"
  ],
  "author": "SIGMACAR Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.31.0"
  },
  "devDependencies": {
    "playwright-core": "1.49.1",
    "qrcode-generator": "1.4.4",
    "three": "0.170.0"
  }
}
